library(tidyverse)
#load the library for rio
library(rio)
#load the library for janitor
library(janitor)
#1: Build a table for NewYorkTimes employees
NYT <- subset(MediaBucks, COMPANY%in% c("NewYorkTimes", "NYT", "Wirecutter_NYT"))
MediaBucks <- rio::import("https://docs.google.com/spreadsheets/d/1y2w31HHwE31N9pJoIB1W8oWgW7citB4hzjo99XfwVqo/edit#gid=357643135", sheet = "RealMediaSalaries2")
MediaSalary <- MediaBucks %>%
filter(Salary >= 1000)
#1: Build a table for NewYorkTimes employees
NYT <- subset(MediaBucks, COMPANY%in% c("NewYorkTimes", "NYT", "Wirecutter_NYT"))
summary(NYT$Salary)
#AI use disclosure here. When I used the COMPANY= command, it wasn't generating a summary. I asked chatGPT and it said I have to use the %in% command instead because the first command only takes one logical condition while this second command allows for the use of three separate filters. I looked at the excel spreadsheet and saw that some people identified as New York Times, and others as NYT or Wirecutter_NYT
#3: Identify title, gender and race of the highest paid position at NYT
NYT%>%
filter(Salary ==max (Salary, na.rm=TRUE))%>%
select(TITLE, Gender, Race, Salary)
#I used AI (chatGPT) because I wasn't sure how to find max value because the example code given showed ways to filter for values above a particular number. Now, I understand that you can just use max(Salary) to find that value. I kept NA values as true here because it doesn't matter if there are null values because I'm just looking for one row rather than trying to do any calculations, I think.
BigBoys <- filter(MediaSalary, COMPANY %in% c("NewYorkTimes", "WallStreetJournal", "Bloomberg"))
Reporters <- subset(MediaBucks, grepl("?reporter", TITLE))
summary(Reporters$Salary)
class(MediaSalary)
Editors <- MediaSalary %>%
filter(TITLE == "Editor")
summary(Editors$Salary)
